    <title>Roblox - 2.250.81045</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            background-color: #f5f5f5;
            color: #333;
        }

        /* ナビゲーションバー */
        .navbar {
            background-color: #fff;
